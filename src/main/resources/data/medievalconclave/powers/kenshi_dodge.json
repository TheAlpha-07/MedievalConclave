{
  "type": "origins:multiple",

  "hit": {
    "type": "origins:resource",
    "min": 0,
    "max": 1,
    "max_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:kenshi_dodge_timer",
      "change": -5
    },
    "start_value": 0
  },

  "hit_true": {
    "type": "origins:self_action_when_hit",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:kenshi_dodge_hit",
      "change": 1
    },
    "damage_condition": {
      "type": "origins:projectile"
    },
    "cooldown": 200
  },

  "timer": {
    "type": "origins:resource",
    "min": 0,
    "max": 3,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    },
    "max_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:kenshi_dodge_hit",
      "change": -1
    }
  },

  "timer_countdown": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:kenshi_dodge_timer",
      "change": 1
    },
    "interval": 20,
    "condition": {
      "type": "origins:resource",
      "resource": "medievalconclave:kenshi_dodge_hit",
      "comparison": "==",
      "compare_to": 1
    }
  },

  "handle_invulnerability": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:if_else",
      "condition": {
        "type": "origins:resource",
        "resource": "medievalconclave:kenshi_dodge_hit",
        "comparison": "==",
        "compare_to": 1
      },
      "if_action": {
        "type": "origins:grant_power",
        "power": "medievalconclave:invulnerability",
        "source": "medievalconclave:kenshi"
      },
      "else_action": {
        "type": "origins:revoke_power",
        "power": "medievalconclave:invulnerability",
        "source": "medievalconclave:kenshi"
      }
    },
    "interval": 2
  }
}