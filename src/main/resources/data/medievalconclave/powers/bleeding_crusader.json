            "comparison": "==",
            "compare_to": 1
          }
        ]
      }
    },
    "interval": 1
  },

  "weapon_speed_reset_longsword": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:bleeding_crusader_weapon_speed_longsword",
      "change": -100
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:ingredient",
            "inverted": true,
            "ingredient": {
              "tag": "spartanweaponry:longswords"
            }
          },
          {
            "type": "origins:enchantment",
            "inverted": true,
            "enchantment": "medievalconclave:longsword_enchantment",
            "comparison": "==",
            "compare_to": 1
          }
        ]
      }
    },
    "interval": 2
  },

  "weapon_speed_reset_greatsword": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
