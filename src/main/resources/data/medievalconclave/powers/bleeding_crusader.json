  },

  "attack_reset": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:delay",
      "ticks": 5,
      "action": {
        "type": "origins:and",
        "actions": [
          {
            "type": "origins:change_resource",
            "resource": "medievalconclave:bleeding_crusader_weapon_speed_longsword",
            "change": -100
          },
          {
            "type": "origins:change_resource",
            "resource": "medievalconclave:bleeding_crusader_weapon_speed_greatsword",
            "change": -100
          }
        ]
      }
    },
    "key": {
      "key": "key.attack"
    },
    "cooldown": 0,
    "hud_render": {
      "should_render": false
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:or",
        "conditions": [
          {
            "type": "origins:ingredient",
            "ingredient": {
              "tag": "spartanweaponry:greatswords"
            }
          },
          {
            "type": "origins:enchantment",
            "enchantment": "medievalconclave:greatsword_enchantment",
            "comparison": "==",
            "compare_to": 1
          }
        ]
      }
    }
  },

  "cooldown_shift": {
    "type": "origins:self_action_on_hit",
    "entity_action": {
      "type": "origins:if_else_list",
      "actions": [
        {
          "condition": {
            "type": "origins:and",
            "conditions": [
              {
                "type": "origins:resource",
                "resource": "medievalconclave:bleeding_crusader_weapon_speed_longsword",
                "comparison": ">=",
                "compare_to": 11.76
              },
              {
                "type": "origins:resource",
                "resource": "medievalconclave:bleeding_crusader_shared_cooldown",
                "comparison": ">=",
                "compare_to": 1000
              }
            ]
          },
          "action": {
            "type": "origins:change_resource",
            "resource": "medievalconclave:bleeding_crusader_shared_cooldown",
            "change": -1000
          }
        },
        {
          "condition": {
            "type": "origins:and",
            "conditions": [
              {
                "type": "origins:resource",
                "resource": "medievalconclave:bleeding_crusader_weapon_speed_greatsword",
                "comparison": ">=",
                "compare_to": 40
              },
              {
                "type": "origins:resource",
                "resource": "medievalconclave:bleeding_crusader_shared_cooldown",
                "comparison": ">=",
                "compare_to": 1000
              }
            ]
          },
          "action": {
            "type": "origins:change_resource",
            "resource": "medievalconclave:bleeding_crusader_shared_cooldown",
            "change": -1000
          }
        }
      ]
    },
    "cooldown": 0
  },

