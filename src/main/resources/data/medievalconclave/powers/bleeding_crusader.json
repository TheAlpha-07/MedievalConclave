{
  "type": "origins:multiple",

  "weapon_speed_longsword": {
    "type": "origins:resource",
    "min": 0,
    "max": 11.76,
    "hud_render": {
      "should_render": false
    }
  },

  "weapon_speed_greatsword": {
    "type": "origins:resource",
    "min": 0,
    "max": 40,
    "hud_render": {
      "should_render": false
    }
  },

  "shared_cooldown": {
    "type": "origins:resource",
    "min": 1000,
    "max": 1000,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
  },

  "cooldown_down": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:bleeding_crusader_shared_cooldown",
      "change": 1
    }
  },

  "weapon_speed_countdown_longsword": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:bleeding_crusader_weapon_speed_longsword",
      "change": 1
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:or",
        "conditions": [
          {
            "type": "origins:ingredient",
            "ingredient": {
              "tag": "spartanweaponry:longswords"
            }
          },
          {
            "type": "origins:enchantment",
            "enchantment": "medievalconclave:longsword_enchantment",
            "comparison": "==",
            "compare_to": 1
          }
        ]
      }
    },
    "interval": 1
  },

  "weapon_speed_countdown_greatsword": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:bleeding_crusader_weapon_speed_greatsword",
      "change": 1
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:or",
        "conditions": [
          {
            "type": "origins:ingredient",
            "ingredient": {
              "tag": "spartanweaponry:greatswords"
            }
          },
          {
            "type": "origins:enchantment",
