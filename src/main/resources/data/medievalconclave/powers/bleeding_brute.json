{
  "type": "origins:multiple",

  "weapon_speed": {
    "type": "origins:resource",
    "min": 0,
    "max": 28.57,
    "hud_render": {
      "should_render": false
    }
  },

  "weapon_speed_countdown": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:bleeding_brute_weapon_speed",
      "change": 1
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:or",
        "conditions": [
          {
            "type": "origins:ingredient",
            "ingredient": {
              "tag": "spartanweaponry:battleaxes"
            }
          },
          {
            "type": "origins:enchantment",
            "enchantment": "medievalconclave:brute_enchantment",
            "comparison": "==",
            "compare_to": 1
          }
        ]
      }
    },
    "interval": 1
  },

  "weapon_speed_reset": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:bleeding_brute_weapon_speed",
      "change": -100
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:ingredient",
            "inverted": true,
            "ingredient": {
              "tag": "spartanweaponry:battleaxes"
            }
          },
          {
            "type": "origins:enchantment",
            "inverted": true,
            "enchantment": "medievalconclave:brute_enchantment",
            "comparison": "==",
            "compare_to": 1
          }
        ]
      }
    },
    "interval": 2
  },

  "attack_reset": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:delay",
      "ticks": 5,
      "action": {
        "type": "origins:change_resource",
        "resource": "medievalconclave:bleeding_brute_weapon_speed",
        "change": -100
      }
    },
    "key": {
      "key": "key.attack"
    },
    "cooldown": 0,
    "hud_render": {
      "should_render": false
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:or",
        "conditions": [
          {
            "type": "origins:ingredient",
            "ingredient": {
              "tag": "spartanweaponry:battleaxes"
            }
          },
          {
            "type": "origins:enchantment",
            "enchantment": "medievalconclave:brute_enchantment",
            "comparison": "==",
            "compare_to": 1
          }
        ]
      }
    }
  },

  "bleeding_inflict": {
    "type": "origins:target_action_on_hit",
    "entity_action": {
      "type": "origins:apply_effect",
      "effect": {
        "effect": "medievalconclave:bleeding",
        "amplifier": 1,
        "duration": 240
      }
    },
    "condition": {
      "type": "origins:resource",
      "resource": "medievalconclave:bleeding_brute_weapon_speed",
      "comparison": ">=",
      "compare_to": 28.57
    },
    "cooldown": 1600,
    "hud_render": {
      "should_render": false
    }
  }
}