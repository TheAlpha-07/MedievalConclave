{
  "type": "origins:multiple",

  "weapon_speed": {
    "type": "origins:resource",
    "min": 0,
    "max": 11.11,
    "hud_render": {
      "should_render": false
    }
  },

  "weapon_speed_countdown": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:stun_hoplite_weapon_speed",
      "change": 1
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:or",
        "conditions": [
          {
            "type": "origins:ingredient",
            "ingredient": {
              "tag": "spartanweaponry:spears"
            }
          },
          {
            "type": "origins:enchantment",
            "enchantment": "medievalconclave:hoplite_enchantment",
            "comparison": "==",
            "compare_to": 1
          }
        ]
      }
    },
    "interval": 1
  },

  "weapon_speed_reset": {
    "type": "origins:action_over_time",
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "medievalconclave:stun_hoplite_weapon_speed",
      "change": -100
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:and",
        "conditions": [
          {
            "type": "origins:ingredient",
            "inverted": true,
            "ingredient": {
              "tag": "spartanweaponry:spears"
            }
          },
          {
            "type": "origins:enchantment",
            "inverted": true,
            "enchantment": "medievalconclave:hoplite_enchantment",
            "comparison": "==",
            "compare_to": 1
          }
        ]
      }
    },
    "interval": 2
  },

  "attack_reset": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:delay",
      "ticks": 5,
      "action": {
        "type": "origins:change_resource",
        "resource": "medievalconclave:stun_hoplite_weapon_speed",
        "change": -100
      }
    },
    "key": {
      "key": "key.attack"
    },
    "cooldown": 0,
    "hud_render": {
      "should_render": false
    },
    "condition": {
      "type": "origins:equipped_item",
      "equipment_slot": "mainhand",
      "item_condition": {
        "type": "origins:or",
        "conditions": [
          {
            "type": "origins:ingredient",
            "ingredient": {
              "tag": "spartanweaponry:spears"
            }
          },
          {
            "type": "origins:enchantment",
            "enchantment": "medievalconclave:stun_hoplite_weapon_speed",
            "comparison": "==",
            "compare_to": 1
          }
        ]
      }
    }
  },

  "stun_inflict": {
    "type": "origins:target_action_on_hit",
    "entity_action": {
      "type": "origins:apply_effect",
      "effects": [
        {
          "effect": "medievalconclave:stun",
          "amplifier": 9,
          "duration": 10
        },
        {
          "effect": "minecraft:weakness",
          "amplifier": 9,
          "duration": 10
        }
      ]
    },
    "condition": {
      "type": "origins:resource",
      "resource": "medievalconclave:stun_hoplite_weapon_speed",
      "comparison": ">=",
      "compare_to": 11.11
    },
    "cooldown": 100,
    "hud_render": {
      "should_render": false
    }
  }
}

